# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Пароль БД: только буквы и цифры (спецсимволы ломают строку подключения).

APP_NAME=Smart-Emulator
DEBUG=true

CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL. Эти же POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB читает контейнер postgres.
# В Docker Compose backend сам подставляет POSTGRES_HOST=postgres.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_please
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_db

# JWT. Секрет: openssl rand -hex 64
JWT_SECRET=change_me_please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REMEMBER_ME_EXPIRE_DAYS=30